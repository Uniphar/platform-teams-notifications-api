{
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "size": "Medium",
      "weight": "Bolder",
      "text": "**LogicAppFlow:** {{LogicAppFlow:string?}}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "**Timestamp:** {{TimeStamp:string?}}",
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "color": "Attention",
      "text": "**Type of error:** {{ObjectType:string?}}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "text": "**Error:**",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "color": "Attention",
      "text": "{{ErrorMessage:string?}}",
      "wrap": true,
      "spacing": "None"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "id": "process",
      "data": {
        "PostOriginalBlobUri": "{{OriginalBlobUri:string?}}",
        "PostFileLocation": "{{FileLocation:file?}}",
        "PostUniqueId": "{{UniqueId:string}}",
        "PostSuccessMessage": "Sent the file to frontgate for reprocessing!"
      },
      "verb": "Process",
      "title": "🔁 Reprocess File"
    },
    {
      "type": "Action.OpenUrl",
      "url": "{{FileUrl:file?}}",
      "title": "📂 Download file"
    },
    {
      "type": "Action.ShowCard",
      "card": {
        "type": "AdaptiveCard",
        "version": "1.6",
        "body": [
          {
            "type": "TextBlock",
            "text": "**Original blob given to Logic App:** `{{OriginalBlobUri:string?}}`",
            "wrap": true,
            "spacing": "None"
          },
          {
            "type": "TextBlock",
            "text": "**Original file given to Logic App (may no longer exist):** {{FileName:file?}}",
            "wrap": true,
            "spacing": "None"
          }
        ],
        "$schema": "https://adaptivecards.io/schemas/adaptive-card.json"
      },
      "title": "🔍 Show more"
    }
  ],
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json"
}
